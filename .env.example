# sandbox = SAP Business Accelerator Hub (API key, read-only)
# system  = real S/4HANA system (basic auth)
SAP_TARGET=sandbox

# Sandbox
SAP_API_KEY=your-api-key-here

# Real system (SAP_TARGET=system)
# SAP_BASE_URL=https://your-host:44300/sap/opu/odata/sap/
# SAP_USER=
# SAP_PASSWORD=
# SAP_VERIFY_SSL=true

# Optional
# SAP_TIMEOUT=30
# Neo4j (docker compose up -d neo4j)
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=choose-a-password-8-chars-min

OLLAMA_MODEL=llama3.2:3b
